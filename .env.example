# Copy to .env and fill in. Never commit .env.
#
# FREE setup (enough for browser testing + the text simulator):
#   GOOGLE_API_KEY   - free at https://aistudio.google.com  (the brain)
#   DEEPGRAM_API_KEY - free credit at https://console.deepgram.com  (ears + mouth)
# Twilio is only needed for real phone calls.

# --- Brain (LLM) ---
# groq = free + fast (recommended) | google = Gemini free tier (5 req/min) | anthropic = Claude (paid)
LLM_PROVIDER=google
GOOGLE_API_KEY=
# Model pools (comma-separated) are set in app/config.py; override with GEMINI_MODEL=... if needed

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
POSTCALL_MODEL=claude-opus-5-5
SIM_REP_MODEL=claude-sonnet-5

# --- Ears + mouth ---
DEEPGRAM_API_KEY=
# deepgram = Aura voices on the same free Deepgram credit (default) | cartesia
TTS_PROVIDER=deepgram
DEEPGRAM_VOICE=aura-2-helena-en
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Twilio (real phone calls only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number the agent calls FROM (E.164, e.g. +13035550100)
TWILIO_FROM_NUMBER=
# Optional second Twilio number wired to /ivr/voice (the fake payer phone menu for testing)
TWILIO_IVR_TEST_NUMBER=

# --- Server ---
# Public https URL Twilio can reach (your ngrok URL), no trailing slash. Not needed for browser mode.
PUBLIC_URL=https://xxxx.ngrok-free.app
PORT=8765

# --- Groq: free, very fast brain, ~30 requests/min (Gemini Flash free = only 5/min) ---
# Get a key at https://console.groq.com/keys, then set LLM_PROVIDER=groq above.
# With LLM_PROVIDER=groq, the after-call check still uses Gemini if GOOGLE_API_KEY is set.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_SIM_REP_MODEL=openai/gpt-oss-120b
